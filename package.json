{
  "name": "notfive-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run typecheck && vite build",
    "codegen": "graphql-codegen --config codegen.ts",
    "typecheck": "bun run codegen && vue-tsc --noEmit -p tsconfig.json --pretty",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "test": "bun run codegen && vitest run",
    "test:watch": "bun run codegen && vitest",
    "test:coverage": "bun run codegen && vitest run --coverage"
  },
  "dependencies": {
    "@graphql-typed-document-node/core": "^3.2.0",
    "@lucide/vue": "^1.46.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "graphql": "^17.1.0",
    "reka-ui": "^2.10.4",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.32",
    "vue-i18n": "11",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@graphql-codegen/cli": "^8.0.0",
    "@graphql-codegen/client-preset": "^7.0.0",
    "@intlify/unplugin-vue-i18n": "^11.2.5",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/user-event": "^14.6.8",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^26.4.1",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/coverage-istanbul": "^5.0.5",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.8.0",
    "jsdom": "^30.1.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.0.10",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.2.7"
  }
}
